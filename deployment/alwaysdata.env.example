APP_NAME=RDSA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rdsa.alwaysdata.net
APP_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=mysql-REMPLACER.alwaysdata.net
DB_PORT=3306
DB_DATABASE=REMPLACER
DB_USERNAME=REMPLACER
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
TRUSTED_PROXIES=

# Aucun envoi d’e-mail n’est actuellement requis par les parcours RDSA.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=bonjour@example.com
MAIL_FROM_NAME=RDSA
